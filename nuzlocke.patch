+void Nz_OnBattleStart(void)
+{
+    sCatchBlocked = FALSE;
+    if (gBattleTypeFlags & BATTLE_TYPE_LINK)
+        return;
+    if (NZ_ON(NZ_BIT_SET_MODE))
+        gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    if (NZ_ON(NZ_BIT_CAPTURE)
+     && !(gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_SAFARI | BATTLE_TYPE_OLD_MAN_TUTORIAL | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_BATTLE_TOWER | BATTLE_TYPE_TRAINER_TOWER)))
+    {
+        u8 area = GetCurrentRegionMapSectionId();
+
+        if (NzAreaUsed(area))
+        {
+            if (!(NZ_ON(NZ_BIT_SHINY) && IsMonShiny(&gEnemyParty[0])))
+                sCatchBlocked = TRUE;
+        }
+        else
+        {
+            NzMarkArea(area);
+        }
+    }
+}
