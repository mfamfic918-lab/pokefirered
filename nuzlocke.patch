diff --git a/include/nuzlocke.h b/include/nuzlocke.h
new file mode 100644
index 0000000..1f4f042
--- /dev/null
+++ b/include/nuzlocke.h
@@ -0,0 +1,58 @@
+#ifndef GUARD_NUZLOCKE_H
+#define GUARD_NUZLOCKE_H
+
+#include "global.h"
+
+// Bit index of each option (stored in gSaveBlock1Ptr->nz.options)
+enum
+{
+    NZ_BIT_CAPTURE,     // only the first wild encounter of each area can be caught
+    NZ_BIT_DEATH,       // fainted Pokemon are dead
+    NZ_BIT_NICKNAME,    // forced nickname on capture
+    NZ_BIT_SET_MODE,    // forced "Set" battle style
+    NZ_BIT_GAMEOVER,    // whiteout = game over
+    NZ_BIT_LEVELCAP,    // level cap by next gym leader
+    NZ_BIT_NOHEAL,      // no healing items in battle
+    NZ_BIT_SHINY,       // shinies ignore the area rule
+    NZ_BIT_GRAVEYARD,   // dead mons go to the PC instead of being released
+    NZ_BIT_RND_WILD,    // random wild Pokemon + starters
+    NZ_BIT_RND_TRAINER, // random trainer teams
+    NZ_BIT_RND_MOVES,   // shuffled learnset moves
+    NZ_BIT_RND_ABILITY, // shuffled abilities
+    NZ_BIT_RND_ITEMS,   // random overworld items
+    NZ_BIT_BAN_LEGEND,  // randomizer never generates legendaries / pseudo-legendaries
+    NZ_OPT_COUNT
+};
+
+#define NZ_ON(bit) ((gSaveBlock1Ptr->nz.options & (1 << (bit))) != 0)
+
+// Hooks used by the rest of the game
