+static const u8 *NzGetState(u8 idx)
+{
+    static const u8 *const sSpeedTexts[] = { sText_Speed0, sText_Speed1, sText_Speed2 };
+    bool8 on;
+
+    if (idx == NZ_IDX_DIFF)
+    {
+        static const u8 *const sDiffTexts[] = { sDiff0, sDiff1, sDiff2, sDiff3 };
+        return sDiffTexts[gSaveBlock1Ptr->nz.difficulty & 3];
+    }
+    if (idx == NZ_IDX_SPEED)
+        return sSpeedTexts[gSaveBlock1Ptr->nz.battleSpeed % 3];
+    if (idx < NZ_OPT_COUNT)
+        on = NZ_ON(idx);
+    else
+        on = (gSaveBlock1Ptr->nz.options2 >> (idx - NZ_IDX_QOL_FIRST)) & 1;
+    return on ? sText_On : sText_Off;
