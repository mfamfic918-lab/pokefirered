+PalletTown_EventScript_AbilityMan::
+	lock
+	faceplayer
+	goto_if_unset FLAG_BADGE01_GET, PalletTown_EventScript_AbilityManNoBadge
+	msgbox PalletTown_Text_AbilityManIntro, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, NO, PalletTown_EventScript_AbilityManBye
+	goto PalletTown_EventScript_AbilityManChoose
+	end
+
+PalletTown_EventScript_AbilityManNoBadge::
+	msgbox PalletTown_Text_AbilityManNoBadge, MSGBOX_DEFAULT
+	release
+	end
+
+PalletTown_EventScript_AbilityManBye::
+	msgbox PalletTown_Text_AbilityManBye, MSGBOX_DEFAULT
+	release
+	end
+
+PalletTown_EventScript_AbilityManChoose::
+	msgbox PalletTown_Text_AbilityManWhichMon, MSGBOX_DEFAULT
+	special ChoosePartyMon
+	waitstate
+	goto_if_ge VAR_0x8004, PARTY_SIZE, PalletTown_EventScript_AbilityManBye
+	specialvar VAR_RESULT, NzPrepareAbilityMenu
+	goto_if_eq VAR_RESULT, 0, PalletTown_EventScript_AbilityManNoOptions
+	msgbox PalletTown_Text_AbilityManPickAbility, MSGBOX_DEFAULT
+	multichoice 0, 0, MULTICHOICE_NZ_ABILITY, FALSE
+	switch VAR_RESULT
+	case 0, PalletTown_EventScript_AbilityManSetFirst
+	case 1, PalletTown_EventScript_AbilityManSetSecond
+	goto PalletTown_EventScript_AbilityManAskAnother
+	end
+
+PalletTown_EventScript_AbilityManSetFirst::
+	setvar VAR_0x8005, 0
+	goto PalletTown_EventScript_AbilityManApply
+	end
+
+PalletTown_EventScript_AbilityManSetSecond::
+	setvar VAR_0x8005, 1
+	goto PalletTown_EventScript_AbilityManApply
+	end
+
+PalletTown_EventScript_AbilityManApply::
+	special NzSetAbility
+	playse SE_EXP_MAX
+	msgbox PalletTown_Text_AbilityManDone, MSGBOX_DEFAULT
+	goto PalletTown_EventScript_AbilityManAskAnother
+	end
+
+PalletTown_EventScript_AbilityManNoOptions::
+	msgbox PalletTown_Text_AbilityManNoOptions, MSGBOX_DEFAULT
+	goto PalletTown_EventScript_AbilityManAskAnother
+	end
+
+PalletTown_EventScript_AbilityManAskAnother::
+	msgbox PalletTown_Text_AbilityManAnother, MSGBOX_YESNO
+	goto_if_eq VAR_RESULT, YES, PalletTown_EventScript_AbilityManChoose
+	goto PalletTown_EventScript_AbilityManBye
+	end
+
+PalletTown_Text_AbilityManIntro:
+	.string "Veo que llevas la MEDALLA ROCA.\n"
+	.string "Eso demuestra que sabes criar.\p"
+	.string "Puedo cambiar la HABILIDAD de un\n"
+	.string "POKéMON por su otra habilidad.\p"
+	.string "¿Quieres probar?$"
+
+PalletTown_Text_AbilityManNoBadge:
+	.string "Si me muestras la MEDALLA ROCA\n"
+	.string "podré cambiar la habilidad de tus\l"
+	.string "POKéMON.$"
+
+PalletTown_Text_AbilityManBye:
+	.string "Vuelve cuando quieras.$"
+
+PalletTown_Text_AbilityManWhichMon:
+	.string "¿Qué POKéMON quieres que mire?$"
+
+PalletTown_Text_AbilityManPickAbility:
+	.string "¿Qué habilidad prefieres para\n"
+	.string "{STR_VAR_1}?$"
+
+PalletTown_Text_AbilityManNoOptions:
