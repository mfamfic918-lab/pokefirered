+// Overworld items (called from Std_FindItem). Key items, HMs and anything
+// that is not a regular item are left alone so the story can't be broken.
+static bool8 NzIsRandomizableItem(u16 item)
+{
+    u8 pocket;
+
+    if (item == ITEM_NONE || item >= ITEM_HM01 || item == ITEM_ENIGMA_BERRY)
+        return FALSE;
+    if (ItemId_GetImportance(item) != 0)
+        return FALSE;
+    if (ItemId_GetName(item)[0] == CHAR_QUESTION_MARK)
+        return FALSE;
+    pocket = ItemId_GetPocket(item);
+    return pocket == POCKET_ITEMS || pocket == POCKET_POKE_BALLS || pocket == POCKET_TM_CASE;
+}
+
+void NzRandomizeItem(void)
+{
+    u16 item = gSpecialVar_0x8000;
+    u32 h;
+    u8 i;
+
+    if (!NZ_ON(NZ_BIT_RND_ITEMS) || !NzIsRandomizableItem(item))
+        return;
+    h = NzHash(item, (gSaveBlock1Ptr->location.mapGroup << 16) | (gSaveBlock1Ptr->location.mapNum << 8) | gSpecialVar_LastTalked);
+    for (i = 0; i < 32; i++)
+    {
+        u16 pick = (h % (ITEM_HM01 - 1)) + 1;
+
+        if (NzIsRandomizableItem(pick))
+        {
+            gSpecialVar_0x8000 = pick;
+            return;
+        }
+        h = NzHash(h, i);
+    }
+}
