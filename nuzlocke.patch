+// Returns 0 = added to party, 1 = sent to PC, 2 = no gift available, 3 = no room.
+u16 NzGiveGift(void)
+{
+    static const u8 sGiftLevels[] = { 15, 18, 23, 37, 37, 41, 44, 59 };
+    u8 badges = 0;
+    u8 idx = gSaveBlock1Ptr->nz.giftsClaimed;
+    u8 i, result;
+    u16 species;
+
+    for (i = 0; i < NUM_BADGES; i++)
+    {
+        if (FlagGet(FLAG_BADGE01_GET + i))
+            badges++;
+    }
+    if (idx >= NELEMS(sGiftLevels) || idx >= badges)
+        return 2;
+    if (gSaveBlock1Ptr->nz.seed == 0)
+        gSaveBlock1Ptr->nz.seed = (Random() % 0xFFFE) + 1;
+    species = Nz_RandomSpecies(SPECIES_BULBASAUR + idx, 0x2000 + idx);
+    result = ScriptGiveMon(species, sGiftLevels[idx], ITEM_NONE, 0, 0, 0);
+    if (result != MON_GIVEN_TO_PARTY && result != MON_GIVEN_TO_PC)
+        return 3;
+    gSaveBlock1Ptr->nz.giftsClaimed++;
+    VarSet(VAR_TEMP_5, species);
+    return result == MON_GIVEN_TO_PARTY ? 0 : 1;
+}
