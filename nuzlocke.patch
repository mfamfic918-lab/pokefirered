diff --git a/include/nuzlocke.h b/include/nuzlocke.h
new file mode 100644
index 0000000..7cde3f8
--- /dev/null
+++ b/include/nuzlocke.h
@@ -0,0 +1,85 @@
+#ifndef GUARD_NUZLOCKE_H
+#define GUARD_NUZLOCKE_H
+
+#include "global.h"
+
+// Bit index of each option (stored in gSaveBlock1Ptr->nz.options)
+enum
+{
+    NZ_BIT_CAPTURE,     // only the first wild encounter of each area can be caught
+    NZ_BIT_DEATH,       // fainted Pokemon are dead
+    NZ_BIT_NICKNAME,    // forced nickname on capture
+    NZ_BIT_SET_MODE,    // forced "Set" battle style
+    NZ_BIT_GAMEOVER,    // whiteout = game over
+    NZ_BIT_LEVELCAP,    // level cap by next gym leader
+    NZ_BIT_NOHEAL,      // no healing items in battle
+    NZ_BIT_SHINY,       // shinies ignore the area rule
+    NZ_BIT_GRAVEYARD,   // dead mons go to the PC instead of being released
+    NZ_BIT_RND_WILD,    // random wild Pokemon + starters
+    NZ_BIT_RND_TRAINER, // random trainer teams
+    NZ_BIT_RND_MOVES,   // shuffled learnset moves
+    NZ_BIT_RND_ABILITY, // shuffled abilities
+    NZ_BIT_RND_ITEMS,   // random overworld items
+    NZ_BIT_BAN_LEGEND,  // randomizer never generates legendaries / pseudo-legendaries
+    NZ_OPT_COUNT
+};
+
+// Quality of life toggles (gSaveBlock1Ptr->nz.options2)
+enum
+{
+    NZ2_BIT_SHOES,      // running shoes from the start + run indoors
+    NZ2_BIT_TM_REUSE,   // reusable TMs
+    NZ2_BIT_REPEL,      // ask to reuse REPEL when it wears off
+    NZ2_BIT_EXPALL,     // whole party gains EXP
+    NZ2_BIT_REMINDER,   // move reminder: pre-evolution moves + Pokemon Centers
+    NZ2_OPT_COUNT
+};
+
+#define NZ2_ON(bit) ((gSaveBlock1Ptr->nz.options2 & (1 << (bit))) != 0)
+
+#define NZ_ON(bit) ((gSaveBlock1Ptr->nz.options & (1 << (bit))) != 0)
+
+// Hooks used by the rest of the game
+void Nz_OnBattleStart(void);
+void Nz_OnBattleEnd(void);
+void Nz_OnWhiteOut(void);
+bool8 Nz_ShouldGameOver(void);
+bool8 Nz_IsItemBlockedInBattle(u16 itemId);
+u32 Nz_ClampExp(struct Pokemon *mon, u32 gain);
+bool8 Nz_IsMonAtLevelCap(struct Pokemon *mon);
+u16 Nz_RandomSpecies(u16 species, u32 salt);
+u16 Nz_WildSpecies(u16 species);
+u16 Nz_TrainerSpecies(u16 species, u16 trainerNum);
+u16 Nz_RandomMove(u16 move, u16 species);
+u8 Nz_RandomAbility(u16 species, u8 abilityNum, u8 original);
+void Nz_SetTrainerMoves(struct Pokemon *mon, const u16 *moves, u16 origSpecies);
+
+// Specials used by scripts
+void NzBufferOptionPrompt(void);
+void NzBufferNameState(void);
+void NzToggleOption(void);
+void NzRandomizeItem(void);
+void NzSoftReset(void);
+void NzRandomizeStarters(void);
+u16 NzIsRandomStarters(void);
+u16 NzGiveGift(void);
+u16 NzIsNickForced(void);
+u16 NzPrepareAbilityMenu(void);
+void NzSetAbility(void);
+extern u8 gNzAbilityText[2][24];
+
+u16 NzRepelHasNext(void);
+void NzUseRepel(void);
+u16 NzReminderOn(void);
+u16 Nz_GetPreEvolution(u16 species);
