+    {
+        // Ruby/Sapphire -> Black 2 -> Kaizo -> Sword -> Ruby/Sapphire
+        static const u8 sNext[4] = { 2, 0, 3, 1 };
+        gSaveBlock1Ptr->nz.difficulty = sNext[gSaveBlock1Ptr->nz.difficulty & 3];
+    }
+    else if (idx == NZ_IDX_SPEED)
+        gSaveBlock1Ptr->nz.battleSpeed = (gSaveBlock1Ptr->nz.battleSpeed + 1) % 3;
+    else if (idx >= NZ_IDX_QOL_FIRST)
+        gSaveBlock1Ptr->nz.options2 ^= (1 << (idx - NZ_IDX_QOL_FIRST));
+    else
+    {
+        gSaveBlock1Ptr->nz.options ^= (1 << idx);
+        if (gSaveBlock1Ptr->nz.seed == 0 && idx >= NZ_BIT_RND_WILD)
+            gSaveBlock1Ptr->nz.seed = (Random() % 0xFFFE) + 1;
+    }
