+u16 NzReminderOn(void)
+{
+    return NZ2_ON(NZ2_BIT_REMINDER) != 0;
+}
+
+// Pallet-style "use another REPEL" prompt. Fills STR_VAR_1 with the item name.
+u16 NzRepelHasNext(void)
+{
+    u16 item = gSaveBlock1Ptr->nz.lastRepel;
+
+    if (!NZ2_ON(NZ2_BIT_REPEL) || item == ITEM_NONE || !CheckBagHasItem(item, 1))
+        return FALSE;
+    CopyItemName(item, gStringVar1);
+    return TRUE;
+}
+
+void NzUseRepel(void)
+{
+    u16 item = gSaveBlock1Ptr->nz.lastRepel;
+
+    if (item == ITEM_NONE || !CheckBagHasItem(item, 1))
+        return;
+    RemoveBagItem(item, 1);
+    VarSet(VAR_REPEL_STEP_COUNT, ItemId_GetHoldEffectParam(item));
+    PlaySE(SE_REPEL);
+}
+
+extern const struct Evolution gEvolutionTable[NUM_SPECIES][EVOS_PER_MON];
+
+// Species that evolves into the given one (SPECIES_NONE if it has none).
+u16 Nz_GetPreEvolution(u16 species)
+{
+    u16 s;
+    u8 e;
+
+    for (s = 1; s < NUM_SPECIES; s++)
+    {
+        for (e = 0; e < EVOS_PER_MON; e++)
+        {
+            if (gEvolutionTable[s][e].method != 0 && gEvolutionTable[s][e].targetSpecies == species)
+                return s;
+        }
+    }
+    return SPECIES_NONE;
+}
+
+// ---------------------------------------------------------------------------
+// Difficulty modes (0 = Ruby/Sapphire, 1 = Sword, 2 = Black 2, 3 = Kaizo)
+// ---------------------------------------------------------------------------
+
+u8 Nz_TrainerLevel(u8 level)
+{
+    static const u8 sPercent[4] = { 100, 85, 112, 125 };
+    u32 lv = (level * sPercent[gSaveBlock1Ptr->nz.difficulty & 3]) / 100;
+
+    if (lv < 1)
+        lv = 1;
+    if (lv > MAX_LEVEL)
+        lv = MAX_LEVEL;
+    return lv;
+}
+
+u8 Nz_TrainerIV(u8 iv)
+{
+    u8 d = gSaveBlock1Ptr->nz.difficulty & 3;
+
+    if (d >= 2)
+        return MAX_PER_STAT_IVS;
+    if (d == 1)
+        return iv / 2;
+    return iv;
+}
+
+u32 Nz_AiFlags(u32 flags)
+{
+    u8 d = gSaveBlock1Ptr->nz.difficulty & 3;
+
+    if (d == 1)
+        return flags & AI_SCRIPT_CHECK_BAD_MOVE;
+    if (d == 2)
+        return flags | AI_SCRIPT_CHECK_BAD_MOVE | AI_SCRIPT_TRY_TO_FAINT | AI_SCRIPT_CHECK_VIABILITY;
+    if (d == 3)
+        return flags | AI_SCRIPT_CHECK_BAD_MOVE | AI_SCRIPT_TRY_TO_FAINT | AI_SCRIPT_CHECK_VIABILITY
+             | AI_SCRIPT_SETUP_FIRST_TURN | AI_SCRIPT_RISKY | AI_SCRIPT_HP_AWARE;
+    return flags;
+}
+
+bool8 Nz_ItemsBlocked(void)
+{
+    return gSaveBlock1Ptr->nz.difficulty == 3 && (gBattleTypeFlags & BATTLE_TYPE_TRAINER);
+}
+
+// ---------------------------------------------------------------------------
+// Special NPC events. VAR_0x8004 = event index.
+// ---------------------------------------------------------------------------
+
+struct NzEvent
+{
+    u8 badges;
+    u16 species;
+    u8 level;
+};
+
+static const struct NzEvent sEvents[] =
+{
+    { 1, SPECIES_EEVEE, 15 },
+    { 2, SPECIES_DRATINI, 20 },
+    { 5, SPECIES_LARVITAR, 30 },
+    { 3, SPECIES_NONE, 0 },   // item event
+};
+
+static u8 NzCountBadges(void)
+{
+    u8 i, n = 0;
+
+    for (i = 0; i < NUM_BADGES; i++)
+    {
+        if (FlagGet(FLAG_BADGE01_GET + i))
+            n++;
+    }
+    return n;
+}
+
+// 0 = available, 1 = already claimed, 2 = not enough badges
+u16 NzEventStatus(void)
+{
+    u8 idx = gSpecialVar_0x8004;
+
+    if (idx >= NELEMS(sEvents))
+        return 1;
+    if (gSaveBlock1Ptr->nz.eventsClaimed & (1 << idx))
+        return 1;
+    if (NzCountBadges() < sEvents[idx].badges)
+        return 2;
+    return 0;
+}
+
+// 0 = into party, 1 = into PC, 3 = no room
+u16 NzEventGiveMon(void)
+{
+    u8 idx = gSpecialVar_0x8004;
+    u16 species;
+    u8 result;
+
+    if (idx >= NELEMS(sEvents) || sEvents[idx].species == SPECIES_NONE)
+        return 3;
+    if (gSaveBlock1Ptr->nz.seed == 0)
+        gSaveBlock1Ptr->nz.seed = (Random() % 0xFFFE) + 1;
+    species = Nz_RandomSpecies(sEvents[idx].species, 0x3000 + idx);
+    result = ScriptGiveMon(species, sEvents[idx].level, ITEM_NONE, 0, 0, 0);
+    if (result != MON_GIVEN_TO_PARTY && result != MON_GIVEN_TO_PC)
+        return 3;
+    gSaveBlock1Ptr->nz.eventsClaimed |= (1 << idx);
+    VarSet(VAR_TEMP_5, species);
+    return result == MON_GIVEN_TO_PARTY ? 0 : 1;
+}
+
+void NzEventMark(void)
+{
+    if (gSpecialVar_0x8004 < 8)
+        gSaveBlock1Ptr->nz.eventsClaimed |= (1 << gSpecialVar_0x8004);
+}
