+
+static const u8 *const sOptionNames[NZ_OPT_COUNT] = {
+    sName_0, sName_1, sName_2, sName_3, sName_4, sName_5, sName_6, sName_7,
+    sName_8, sName_9, sName_10, sName_11, sName_12, sName_13, sName_14
+};
+
+static const u8 *const sOptionDescs[NZ_OPT_COUNT] = {
+    sDesc_0, sDesc_1, sDesc_2, sDesc_3, sDesc_4, sDesc_5, sDesc_6, sDesc_7,
+    sDesc_8, sDesc_9, sDesc_10, sDesc_11, sDesc_12, sDesc_13, sDesc_14
+};
+
+// ---------------------------------------------------------------------------
+// Menu helpers (called from scripts)
+// ---------------------------------------------------------------------------
+
+void NzBufferOptionPrompt(void)
+{
+    u8 idx = gSpecialVar_0x8004;
+
+    if (idx >= NZ_OPT_COUNT)
+        idx = 0;
+    StringCopy(gStringVar4, sOptionDescs[idx]);
+    StringAppend(gStringVar4, sText_PageBreak);
+    StringAppend(gStringVar4, sOptionNames[idx]);
+    StringAppend(gStringVar4, sText_Colon);
+    StringAppend(gStringVar4, NZ_ON(idx) ? sText_On : sText_Off);
+    StringAppend(gStringVar4, sText_Ask);
+}
+
+void NzBufferNameState(void)
+{
+    u8 idx = gSpecialVar_0x8004;
+
+    if (idx >= NZ_OPT_COUNT)
+        idx = 0;
+    StringCopy(gStringVar1, sOptionNames[idx]);
+    StringCopy(gStringVar2, NZ_ON(idx) ? sText_On : sText_Off);
+}
+
+void NzToggleOption(void)
+{
+    u8 idx = gSpecialVar_0x8004;
+
+    if (idx >= NZ_OPT_COUNT)
+        return;
+    gSaveBlock1Ptr->nz.options ^= (1 << idx);
+    if (gSaveBlock1Ptr->nz.seed == 0 && idx >= NZ_BIT_RND_WILD)
+        gSaveBlock1Ptr->nz.seed = (Random() % 0xFFFE) + 1;
+    NzBufferNameState();
+}
+
+void NzSoftReset(void)
+{
+    DoSoftReset();
+}
+
+// Oak's Lab: VAR_TEMP_1 = ball chosen by the player (0 Bulbasaur, 1 Squirtle,
+// 2 Charmander), VAR_TEMP_2 = player's starter species, VAR_TEMP_3 = rival's.
+void NzRandomizeStarters(void)
+{
+    static const u16 sPlayerBase[] = { SPECIES_BULBASAUR, SPECIES_SQUIRTLE, SPECIES_CHARMANDER };
+    static const u16 sRivalBase[] = { SPECIES_CHARMANDER, SPECIES_BULBASAUR, SPECIES_SQUIRTLE };
+    static const u16 sRivalTrainer[] = { TRAINER_RIVAL_OAKS_LAB_CHARMANDER, TRAINER_RIVAL_OAKS_LAB_BULBASAUR, TRAINER_RIVAL_OAKS_LAB_SQUIRTLE };
+    u16 num = VarGet(VAR_TEMP_1);
+
+    if (num >= NELEMS(sPlayerBase))
+        return;
+    if (NZ_ON(NZ_BIT_RND_WILD))
+        VarSet(VAR_TEMP_2, Nz_RandomSpecies(sPlayerBase[num], 0x1000 + num));
+    VarSet(VAR_TEMP_3, Nz_TrainerSpecies(sRivalBase[num], sRivalTrainer[num]));
+}
+
+u16 NzIsRandomStarters(void)
+{
+    return NZ_ON(NZ_BIT_RND_WILD) != 0;
+}
+
+// ---------------------------------------------------------------------------
+// Hashing / randomizer
+// ---------------------------------------------------------------------------
+
+static u32 NzHash(u32 a, u32 b)
+{
+    u32 x = a * 0x9E3779B1u + (b ^ (((u32)gSaveBlock1Ptr->nz.seed << 16) | 0x5BD1u)) * 0x85EBCA6Bu + 0x1234567u;
+
+    x ^= x >> 15;
+    x *= 0x2C1B3C6Du;
+    x ^= x >> 12;
+    x *= 0x297A2D39u;
+    x ^= x >> 15;
+    return x;
+}
+
+static bool8 NzIsLegendaryOrPseudo(u16 s)
+{
+    switch (s)
+    {
+    case SPECIES_ARTICUNO: case SPECIES_ZAPDOS: case SPECIES_MOLTRES:
+    case SPECIES_MEWTWO: case SPECIES_MEW:
+    case SPECIES_RAIKOU: case SPECIES_ENTEI: case SPECIES_SUICUNE:
+    case SPECIES_LUGIA: case SPECIES_HO_OH: case SPECIES_CELEBI:
+    case SPECIES_REGIROCK: case SPECIES_REGICE: case SPECIES_REGISTEEL:
+    case SPECIES_LATIAS: case SPECIES_LATIOS:
+    case SPECIES_KYOGRE: case SPECIES_GROUDON: case SPECIES_RAYQUAZA:
+    case SPECIES_JIRACHI: case SPECIES_DEOXYS:
+    case SPECIES_DRATINI: case SPECIES_DRAGONAIR: case SPECIES_DRAGONITE:
+    case SPECIES_LARVITAR: case SPECIES_PUPITAR: case SPECIES_TYRANITAR:
+    case SPECIES_BAGON: case SPECIES_SHELGON: case SPECIES_SALAMENCE:
+    case SPECIES_BELDUM: case SPECIES_METANG: case SPECIES_METAGROSS:
+        return TRUE;
+    }
+    return FALSE;
+}
+
+#define NZ_NUM_SPECIES_GEN12 SPECIES_CELEBI
+#define NZ_NUM_SPECIES_GEN3  (SPECIES_EGG - SPECIES_TREECKO)
+
+static u16 NzPickSpecies(u32 h)
+{
+    u32 idx = h % (NZ_NUM_SPECIES_GEN12 + NZ_NUM_SPECIES_GEN3);
+
+    if (idx < NZ_NUM_SPECIES_GEN12)
+        return idx + 1;
+    return SPECIES_TREECKO + (idx - NZ_NUM_SPECIES_GEN12);
+}
+
+u16 Nz_RandomSpecies(u16 species, u32 salt)
+{
+    u32 h = NzHash(species, salt);
+    u8 i;
+
+    for (i = 0; i < 24; i++)
+    {
+        u16 pick = NzPickSpecies(h);
+
+        // Unown is never generated: it can only learn one move.
+        if (pick != SPECIES_UNOWN && !(NZ_ON(NZ_BIT_BAN_LEGEND) && NzIsLegendaryOrPseudo(pick)))
+            return pick;
+        h = NzHash(h, i + 1);
+    }
+    return species;
+}
+
+u16 Nz_WildSpecies(u16 species)
+{
+    if (!NZ_ON(NZ_BIT_RND_WILD) || species == SPECIES_NONE)
+        return species;
+    return Nz_RandomSpecies(species, 0x100 + GetCurrentRegionMapSectionId());
+}
+
+u16 Nz_TrainerSpecies(u16 species, u16 trainerNum)
+{
+    if (!NZ_ON(NZ_BIT_RND_TRAINER) || species == SPECIES_NONE)
+        return species;
+    return Nz_RandomSpecies(species, 0x10000 + trainerNum);
+}
+
+u16 Nz_RandomMove(u16 move, u16 species)
+{
+    u32 h;
+    u8 i;
+
+    if (!NZ_ON(NZ_BIT_RND_MOVES) || move == MOVE_NONE)
+        return move;
+    h = NzHash(move, species + 0x4000);
+    for (i = 0; i < 8; i++)
+    {
+        u16 m = (h % (MOVES_COUNT - 1)) + 1;
+
+        if (m != MOVE_STRUGGLE)
+            return m;
+        h = NzHash(h, i);
+    }
+    return move;
+}
+
+u8 Nz_RandomAbility(u16 species, u8 abilityNum, u8 original)
+{
+    if (!NZ_ON(NZ_BIT_RND_ABILITY) || original == ABILITY_NONE)
+        return original;
+    return (NzHash(species + 0x8000, abilityNum) % (ABILITIES_COUNT - 1)) + 1;
+}
+
+void Nz_SetTrainerMoves(struct Pokemon *mon, const u16 *moves, u16 origSpecies)
+{
+    u8 i;
+
+    // If the species was randomized the default moveset is used instead.
+    if (GetMonData(mon, MON_DATA_SPECIES, NULL) != origSpecies)
+        return;
+    for (i = 0; i < MAX_MON_MOVES; i++)
+    {
+        u16 move = Nz_RandomMove(moves[i], origSpecies);
+        SetMonData(mon, MON_DATA_MOVE1 + i, &move);
+        SetMonData(mon, MON_DATA_PP1 + i, &gBattleMoves[move].pp);
+    }
+}
+
+// Overworld items (called from Std_FindItem). Key items, HMs and anything
+// that is not a regular item are left alone so the story can't be broken.
+static bool8 NzIsRandomizableItem(u16 item)
+{
+    u8 pocket;
+
+    if (item == ITEM_NONE || item >= ITEM_HM01 || item == ITEM_ENIGMA_BERRY)
+        return FALSE;
+    if (ItemId_GetImportance(item) != 0)
+        return FALSE;
+    if (ItemId_GetName(item)[0] == CHAR_QUESTION_MARK)
+        return FALSE;
+    pocket = ItemId_GetPocket(item);
+    return pocket == POCKET_ITEMS || pocket == POCKET_POKE_BALLS || pocket == POCKET_TM_CASE;
+}
+
+void NzRandomizeItem(void)
+{
+    u16 item = gSpecialVar_0x8000;
+    u32 h;
+    u8 i;
+
+    if (!NZ_ON(NZ_BIT_RND_ITEMS) || !NzIsRandomizableItem(item))
+        return;
+    h = NzHash(item, (gSaveBlock1Ptr->location.mapGroup << 16) | (gSaveBlock1Ptr->location.mapNum << 8) | gSpecialVar_LastTalked);
+    for (i = 0; i < 32; i++)
+    {
+        u16 pick = (h % (ITEM_HM01 - 1)) + 1;
+
+        if (NzIsRandomizableItem(pick))
+        {
+            gSpecialVar_0x8000 = pick;
+            return;
+        }
+        h = NzHash(h, i);
+    }
+}
+
+// ---------------------------------------------------------------------------
+// Nuzlocke rules
+// ---------------------------------------------------------------------------
+
+static bool8 NzAreaUsed(u8 area)
+{
+    return (gSaveBlock1Ptr->nz.areaUsed[area >> 3] >> (area & 7)) & 1;
+}
+
+static void NzMarkArea(u8 area)
+{
+    gSaveBlock1Ptr->nz.areaUsed[area >> 3] |= 1 << (area & 7);
+}
+
+void Nz_OnBattleStart(void)
+{
+    sCatchBlocked = FALSE;
+    if (gBattleTypeFlags & BATTLE_TYPE_LINK)
+        return;
+    if (NZ_ON(NZ_BIT_SET_MODE))
+        gSaveBlock2Ptr->optionsBattleStyle = OPTIONS_BATTLE_STYLE_SET;
+    if (NZ_ON(NZ_BIT_CAPTURE)
+     && !(gBattleTypeFlags & (BATTLE_TYPE_TRAINER | BATTLE_TYPE_SAFARI | BATTLE_TYPE_OLD_MAN_TUTORIAL | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_BATTLE_TOWER | BATTLE_TYPE_TRAINER_TOWER)))
+    {
+        u8 area = GetCurrentRegionMapSectionId();
+
+        if (NzAreaUsed(area))
+        {
+            if (!(NZ_ON(NZ_BIT_SHINY) && IsMonShiny(&gEnemyParty[0])))
+                sCatchBlocked = TRUE;
+        }
+        else
+        {
+            NzMarkArea(area);
+        }
+    }
+}
+
+bool8 Nz_IsItemBlockedInBattle(u16 itemId)
+{
+    if (NZ_ON(NZ_BIT_NOHEAL) && ItemId_GetBattleUsage(itemId) == 1)
+        return TRUE;
+    if (sCatchBlocked && ItemId_GetPocket(itemId) == POCKET_POKE_BALLS)
+        return TRUE;
+    return FALSE;
+}
+
+void Nz_OnBattleEnd(void)
+{
+    u8 i;
+    u8 alive = 0;
+
+    if (!NZ_ON(NZ_BIT_DEATH))
+        return;
+    if (gBattleTypeFlags & (BATTLE_TYPE_LINK | BATTLE_TYPE_POKEDUDE | BATTLE_TYPE_OLD_MAN_TUTORIAL))
+        return;
+    if (gBattleOutcome == B_OUTCOME_LOST || gBattleOutcome == B_OUTCOME_DREW)
+        return; // whiteout is handled elsewhere
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        if (GetMonData(&gPlayerParty[i], MON_DATA_SPECIES, NULL) != SPECIES_NONE
+         && !GetMonData(&gPlayerParty[i], MON_DATA_IS_EGG, NULL)
+         && GetMonData(&gPlayerParty[i], MON_DATA_HP, NULL) != 0)
+            alive++;
+    }
+    if (alive == 0)
+        return;
+    for (i = 0; i < PARTY_SIZE; i++)
+    {
+        struct Pokemon *mon = &gPlayerParty[i];
+
+        if (GetMonData(mon, MON_DATA_SPECIES, NULL) != SPECIES_NONE
+         && !GetMonData(mon, MON_DATA_IS_EGG, NULL)
+         && GetMonData(mon, MON_DATA_HP, NULL) == 0)
+        {
+            u16 item = GetMonData(mon, MON_DATA_HELD_ITEM, NULL);
+
+            if (item != ITEM_NONE)
+                AddBagItem(item, 1);
+            if (NZ_ON(NZ_BIT_GRAVEYARD))
+                Nz_SendMonToPC(mon);
+            ZeroMonData(mon);
+        }
+    }
+    CompactPartySlots();
+}
+
+void Nz_OnWhiteOut(void)
+{
+    if (NZ_ON(NZ_BIT_GAMEOVER))
+        sGameOver = TRUE;
+}
+
+bool8 Nz_ShouldGameOver(void)
+{
+    bool8 r = sGameOver;
+
+    sGameOver = FALSE;
+    return r;
+}
+
+static u8 NzGetLevelCap(void)
+{
+    // Ace level of the next gym leader, indexed by the number of badges.
+    static const u8 sCaps[] = { 14, 21, 24, 29, 43, 43, 47, 50, 65 };
+    u8 badges = 0;
+    u8 i;
+
+    for (i = 0; i < NUM_BADGES; i++)
+    {
+        if (FlagGet(FLAG_BADGE01_GET + i))
+            badges++;
+    }
+    if (badges >= NUM_BADGES && FlagGet(FLAG_SYS_GAME_CLEAR))
+        return MAX_LEVEL;
+    return sCaps[badges];
+}
+
+bool8 Nz_IsMonAtLevelCap(struct Pokemon *mon)
+{
+    if (!NZ_ON(NZ_BIT_LEVELCAP))
+        return FALSE;
+    return GetMonData(mon, MON_DATA_LEVEL, NULL) >= NzGetLevelCap();
+}
+
+u32 Nz_ClampExp(struct Pokemon *mon, u32 gain)
+{
+    u16 species;
+    u32 maxExp, cur;
+
+    if (!NZ_ON(NZ_BIT_LEVELCAP))
+        return gain;
+    species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    maxExp = gExperienceTables[gSpeciesInfo[species].growthRate][NzGetLevelCap()];
+    cur = GetMonData(mon, MON_DATA_EXP, NULL);
+    if (cur >= maxExp)
+        return 0;
+    if (cur + gain > maxExp)
+        return maxExp - cur;
+    return gain;
+}
+
+// ---------------------------------------------------------------------------
+// Badge gifts (bedroom PC): one random Pokemon for each gym badge earned.
+// ---------------------------------------------------------------------------
+
+u16 NzIsNickForced(void)
+{
+    return NZ_ON(NZ_BIT_NICKNAME) != 0;
+}
+
+// Returns 0 = added to party, 1 = sent to PC, 2 = no gift available, 3 = no room.
+u16 NzGiveGift(void)
+{
+    static const u8 sGiftLevels[] = { 15, 18, 23, 37, 37, 41, 44, 59 };
+    u8 badges = 0;
+    u8 idx = gSaveBlock1Ptr->nz.giftsClaimed;
+    u8 i, result;
+    u16 species;
+
+    for (i = 0; i < NUM_BADGES; i++)
+    {
+        if (FlagGet(FLAG_BADGE01_GET + i))
+            badges++;
+    }
+    if (idx >= NELEMS(sGiftLevels) || idx >= badges)
+        return 2;
+    if (gSaveBlock1Ptr->nz.seed == 0)
+        gSaveBlock1Ptr->nz.seed = (Random() % 0xFFFE) + 1;
+    species = Nz_RandomSpecies(SPECIES_BULBASAUR + idx, 0x2000 + idx);
+    result = ScriptGiveMon(species, sGiftLevels[idx], ITEM_NONE, 0, 0, 0);
+    if (result != MON_GIVEN_TO_PARTY && result != MON_GIVEN_TO_PC)
+        return 3;
+    gSaveBlock1Ptr->nz.giftsClaimed++;
+    VarSet(VAR_TEMP_5, species);
+    return result == MON_GIVEN_TO_PARTY ? 0 : 1;
+}
+
+// ---------------------------------------------------------------------------
+// Pallet Town ability changer. Gen 3 has two ability slots per species.
+// ---------------------------------------------------------------------------
+
+u8 gNzAbilityText[2][24];
+
+static const u8 sText_Current[] = _(" (actual)");
+
+// VAR_0x8004 = party slot. Returns 1 if the mon has two different abilities and
+// fills the menu texts and STR_VAR_1 (nickname); returns 0 otherwise.
+u16 NzPrepareAbilityMenu(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gSpecialVar_0x8004];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u8 current = GetMonData(mon, MON_DATA_ABILITY_NUM, NULL);
+    u8 ability[2];
+    u8 i;
+
+    GetMonData(mon, MON_DATA_NICKNAME, gStringVar1);
+    if (species == SPECIES_NONE || GetMonData(mon, MON_DATA_IS_EGG, NULL))
+        return 0;
+    ability[0] = GetAbilityBySpecies(species, 0);
+    ability[1] = GetAbilityBySpecies(species, 1);
+    if (ability[1] == ABILITY_NONE || ability[0] == ability[1])
+        return 0;
+    for (i = 0; i < 2; i++)
+    {
+        StringCopyN(gNzAbilityText[i], gAbilityNames[ability[i]], 13);
+        if (i == (current != 0))
+            StringAppend(gNzAbilityText[i], sText_Current);
+    }
+    return 1;
+}
+
+// VAR_0x8004 = party slot, VAR_0x8005 = ability slot (0 or 1).
+void NzSetAbility(void)
+{
+    struct Pokemon *mon = &gPlayerParty[gSpecialVar_0x8004];
+    u16 species = GetMonData(mon, MON_DATA_SPECIES, NULL);
+    u8 slot = gSpecialVar_0x8005 != 0;
+
+    SetMonData(mon, MON_DATA_ABILITY_NUM, &slot);
+    StringCopy(gStringVar2, gAbilityNames[GetAbilityBySpecies(species, slot)]);
+}
